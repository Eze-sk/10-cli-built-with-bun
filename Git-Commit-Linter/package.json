{
  "name": "cli-cmt-git",
  "type": "module",
  "version": "1.0.0",
  "author": "ezesk",
  "bin": {
    "cli-cmt-git": "./src/bin/cli.tsx"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "dev": "bun run --watch ./src/bin/cli.tsx",
    "start": "bun run ./src/bin/cli.tsx",
    "build": "bun build src/cli.tsx --target=node --outfile=dist/cli.js",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --fix --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/bun": "latest",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "bun-types": "^1.4.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "ink-testing-library": "^4.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.53",
    "@ai-sdk/deepseek": "3.0.44",
    "@ai-sdk/google": "4.0.68",
    "@ai-sdk/openai": "4.0.66",
    "@inkjs/ui": "2.0.0",
    "ai": "7.0.98",
    "ink": "7.1.1",
    "keytar": "7.9.0",
    "meow": "14.1.0",
    "react": "19.3.0",
    "zod": "4.6.2",
    "zustand": "5.0.15"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5"
}
